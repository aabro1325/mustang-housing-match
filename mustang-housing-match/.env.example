# Mustang Housing Match — copy to .env (git-ignored) and fill in.
# Every VITE_* value is embedded in the extension bundle, where anyone who unpacks the extension can read it.
# Only public configuration and zero-financial-exposure keys belong here. Never AWS access keys.

# ---- Providers (fixture = no network, for tests and demos; live = real services) ----
VITE_COMMUTE_PROVIDER=fixture
VITE_SHARING_PROVIDER=local

# ---- Release scope (omit or "full" for every feature; "alpha" is capture + fit score only) ----
# The alpha zip is `npm run build:alpha`, which loads .env.alpha. Leave this unset for normal dev.
# VITE_RELEASE_SCOPE=full

# ---- Commute (issue #9): openrouteservice Standard plan key (account.heigit.org) and Transitland Routing API
#      beta key (Interline account). Both free, no card. Public by design; the worst case is quota exhaustion.
VITE_ORS_API_KEY=
VITE_TRANSITLAND_API_KEY=

# ---- Shared List backend (issue #10): values from amplify_outputs.json after `npx ampx sandbox --identifier pilot --once`
VITE_AWS_REGION=us-west-2
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_APPSYNC_GRAPHQL_ENDPOINT=
VITE_APPSYNC_AUTH_MODE=identityPool
# Base of the Invitation Link; the GitHub Pages landing page in docs/join/ by default.
VITE_INVITE_LINK_BASE=https://aabro1325.github.io/mustang-housing-match/join/

# ---- Developer machine only (not VITE_, never bundled) ----
AWS_PROFILE=amplify-admin
AWS_REGION=us-west-2
AMPLIFY_SANDBOX_IDENTIFIER=pilot
