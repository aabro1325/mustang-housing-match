{
  "manifest_version": 3,
  "name": "Mustang Housing Match",
  "version": "1.0.0",
  "description": "Score off-campus rentals for Cal Poly: capture a listing, compare cost and commute, and decide with roommates.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.zillow.com/*",
    "https://*.craigslist.org/*",
    "https://*.apartments.com/*",
    "https://*.redfin.com/*",
    "https://*.facebook.com/*",
    "https://api.openrouteservice.org/*",
    "https://transit.land/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "options_ui": { "page": "src/options/index.html", "open_in_tab": true },
  "action": { "default_title": "Open Mustang Housing Match" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
